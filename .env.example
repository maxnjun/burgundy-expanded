# Local/durable-disk mode (default). Render Free uses the external mode below.
BURGUNDY_DATA_DIR=/var/data/burgundy
# Render Free: set these in Render Environment; never use NEXT_PUBLIC_ for credentials.
# BURGUNDY_STORAGE=upstash
# BURGUNDY_ROOM_NAMESPACE=staging
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-in-render-secret-settings
# Set APP_ORIGIN only for a custom domain, including https:// and no path.
# APP_ORIGIN=https://game.example.com
# TRUST_PROXY=1 is only for the known Render reverse proxy.
TRUST_PROXY=1
# Local builds default to development; CI/Render builds set the exact commit SHA.
# GAME_VERSION=development
# NEXT_PUBLIC_GAME_VERSION=development
