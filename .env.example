# Render supplies PORT and RENDER_EXTERNAL_URL. Never put seat tokens or deploy hooks here.
BURGUNDY_DATA_DIR=/var/data/burgundy
# Set APP_ORIGIN only for a custom domain, including https:// and no path.
# APP_ORIGIN=https://game.example.com
# TRUST_PROXY=1 is only for the known Render reverse proxy.
TRUST_PROXY=1
# Local builds default to development; CI/Render builds set the exact commit SHA.
# GAME_VERSION=development
# NEXT_PUBLIC_GAME_VERSION=development
