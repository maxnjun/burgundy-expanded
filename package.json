{
  "name": "burgundy-expanded",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/server.mjs",
    "lint": "eslint",
    "test:boards": "node tests/boards/run.mjs",
    "test:core": "node tests/core/run.mjs",
    "test:browser": "playwright test",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "android:web": "node scripts/android-web.mjs",
    "android:sync": "npm run android:web && cap sync android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs debug",
    "android:release": "npm run android:sync && node scripts/android-build.mjs release",
    "test:android": "node --test tests/android/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
